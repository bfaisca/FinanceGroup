{
  "name": "groupfinance-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.vitest.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@primeuix/themes": "^2.0.3",
    "axios": "^1.21.1",
    "echarts": "^6.1.0",
    "pinia": "^4.1.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.45",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
