# Copie para .env e ajuste os valores. NUNCA versione o arquivo .env.

# ---------- PostgreSQL ----------
POSTGRES_DB=groupfinance
POSTGRES_USER=groupfinance
POSTGRES_PASSWORD=change-me-strong-password
DB_PORT=5432

# ---------- API ----------
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
# Segredo de assinatura do JWT: mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-chars
JWT_ISSUER=GroupFinance
JWT_AUDIENCE=GroupFinance.Web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Fuso horário IANA da aplicação: define "hoje" (vencidas, datas futuras, saldo projetado). D-021
APP_TIMEZONE=America/Sao_Paulo

# Recorrências (D-027): horizonte de geração das ocorrências (meses à frente de "hoje"),
# intervalo do serviço em segundo plano (minutos) e liga/desliga do serviço. Seguro com várias instâncias.
RECURRENCE_HORIZON_MONTHS=12
RECURRENCE_GENERATION_INTERVAL_MINUTES=360
RECURRENCE_BACKGROUND_ENABLED=true

# ---------- Frontend ----------
WEB_PORT=8080
# URL pública do frontend (usada nos links de e-mail)
FRONTEND_BASE_URL=http://localhost:8080

# ---------- E-mail (Mailpit em desenvolvimento) ----------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_FROM=no-reply@groupfinance.local
MAILPIT_UI_PORT=8025
